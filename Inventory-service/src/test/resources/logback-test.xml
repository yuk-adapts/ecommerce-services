<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Colorful console output for tests -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %highlight(%-5level) %magenta([%thread]) %cyan(%logger{36}) - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Special appender for demo service with custom colors -->
    <appender name="DEMO_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %boldYellow([DEMO]) %green(%-30logger{0}) %boldCyan(➜) %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Root logger -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

    <!-- Demo service with custom colors -->
    <logger name="com.vv456.Inventory_service.service.TransactionDemoService" level="INFO" additivity="false">
        <appender-ref ref="DEMO_CONSOLE"/>
    </logger>

    <!-- Test class with custom colors -->
    <logger name="com.vv456.Inventory_service.TransactionDemoIntegrationTest" level="INFO" additivity="false">
        <appender-ref ref="DEMO_CONSOLE"/>
    </logger>

    <!-- Reduce noise from these frameworks -->
    <logger name="org.springframework" level="WARN"/>
    <logger name="org.hibernate" level="WARN"/>
    <logger name="com.zaxxer.hikari" level="WARN"/>
    <logger name="org.flywaydb" level="WARN"/>
</configuration>
